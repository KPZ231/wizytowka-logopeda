# Sekret Payload (podpis sesji/JWT) — losowy długi ciąg, nigdy nie commituj prawdziwej wartości.
PAYLOAD_SECRET=

# Connection string Postgresa na Neon (pooled), gałąź "dev" do pracy lokalnej.
# Produkcja: osobna gałąź/baza, migracje wyłącznie przez `payload migrate` (bez `push`).
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# Token Vercel Blob (store do plików media/gallery).
BLOB_READ_WRITE_TOKEN=

# Public key widżetu czatu Tidio (Settings → Install → Code). Bez niego ChatLauncher się nie renderuje.
NEXT_PUBLIC_TIDIO_KEY=
